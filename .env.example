# ===== 应用基础 =====
APP_NAME=MES运维智能体
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== 安全 =====
# JWT 密钥（请改为随机长字符串，可用：openssl rand -hex 32）
JWT_SECRET=please-change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12

# ===== 数据库（SQLite，单文件，无需额外进程） =====
DB_PATH=./data/mes_agent.db

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ===== MiniMax LLM（Anthropic 兼容端点） =====
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=minimax-portal/MiniMax-M2.7
MINIMAX_API_KEY=sk-cp-REPLACE-WITH-YOUR-OWN-KEY
MINIMAX_MAX_TOKENS=4096

# ===== 初始管理员（首次启动自动创建） =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_EMAIL=admin@example.com
